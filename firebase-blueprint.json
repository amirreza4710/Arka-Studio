{
  "entities": {
    "OrganizationRecord": {
      "title": "OrganizationRecord",
      "description": "Canonical Arka organization root document (arka_org).",
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "enum": ["arka_org"]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orgId", "name", "ownerUid", "updatedAt"]
    },
    "OrganizationMemberRecord": {
      "title": "OrganizationMemberRecord",
      "description": "Organization membership and RBAC role assignment inside arka_org.",
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "enum": ["arka_org"]
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "editor", "viewer"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orgId", "userId", "email", "role", "updatedAt"]
    },
    "OrganizationBrandProfileRecord": {
      "title": "OrganizationBrandProfileRecord",
      "description": "Single canonical organization-level Arka Brand Profile (versioned) under /organizations/arka_org/settings/brandProfile.",
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "enum": ["arka_org"]
        },
        "version": {
          "type": "number"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "profileJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 25000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orgId", "version", "updatedByUid", "updatedByEmail", "profileJson", "updatedAt"]
    },
    "AiGenerationRecord": {
      "title": "AiGenerationRecord",
      "description": "Stores AI-generated Instagram scenarios, slides, captions, SEO/AEO/GEO articles, and sales campaigns created by a signed-in Google user in Arka Studio.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mode": {
          "type": "string",
          "description": "AI generation mode",
          "enum": [
            "canvas-slide",
            "carousel-deck",
            "reels-script",
            "campaign-plan",
            "campaign-calendar-30",
            "seo-article"
          ],
          "minLength": 3,
          "maxLength": 40
        },
        "productId": {
          "type": "string",
          "description": "Selected Arka product identifier from arka-acc.ir",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the generated scenario, article, or campaign",
          "minLength": 1,
          "maxLength": 300
        },
        "contentJson": {
          "type": "string",
          "description": "Serialized JSON payload of the generated AI content",
          "minLength": 2,
          "maxLength": 60000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the generation was saved"
        }
      },
      "required": ["userId", "mode", "productId", "title", "contentJson", "createdAt"]
    },
    "UserPreferenceRecord": {
      "title": "UserPreferenceRecord",
      "description": "Per-user non-sensitive UI theme and connection mode preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "darkMode": {
          "type": "boolean"
        },
        "preferredConnectionMode": {
          "type": "string",
          "enum": ["gmail-authenticated", "custom-byok", "studio-creator-core"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "darkMode", "preferredConnectionMode", "updatedAt"]
    },
    "BrandProfileRecord": {
      "title": "BrandProfileRecord",
      "description": "Legacy per-user brand profile record preserved for non-destructive backward-compatible migration to /organizations/arka_org/settings/brandProfile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profileJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "profileJson", "updatedAt"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/OrganizationRecord" },
      "description": "Canonical organization document (arka_org)."
    },
    "/organizations/{orgId}/members/{userId}": {
      "schema": { "$ref": "#/entities/OrganizationMemberRecord" },
      "description": "Organization membership & role assignment records for arka_org."
    },
    "/organizations/{orgId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/OrganizationBrandProfileRecord" },
      "description": "Canonical organization-level Arka Brand Profile (brandProfile)."
    },
    "/users/{userId}/aiGenerations/{genId}": {
      "schema": { "$ref": "#/entities/AiGenerationRecord" },
      "description": "Private per-user collection of AI-generated Arka campaigns, SEO/AEO/GEO articles, Reels scripts, and slides."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserPreferenceRecord" },
      "description": "Private per-user settings documents (preferences, plus legacy read-compatible brandProfile)."
    }
  }
}
